rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Accept the legacy admin account, custom claims, or a role-based admin profile.
    function isAdmin() {
      return request.auth != null &&
             (
               request.auth.token.email == 'admin@gmail.com' ||
               request.auth.token.admin == true ||
               request.auth.token.role == 'admin' ||
               (
                 exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
                 get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
               )
             );
    }

    function isCompletingAssignedTour(instanceId) {
      let bookingId = request.resource.data.get('completionBookingId', '');
      let completedBooking = getAfter(
        /databases/$(database)/documents/bookings/$(bookingId)
      ).data;
      return request.auth != null &&
             bookingId is string &&
             bookingId != '' &&
             completedBooking.get('instanceId', '') == instanceId &&
             completedBooking.get('status', '') == 'completed' &&
             completedBooking.get('completedBy', '') == request.auth.uid &&
             (
               completedBooking.get('driverId', '') == request.auth.uid ||
               (
                 request.auth.token.email != null &&
                 completedBooking.get('driverEmail', '') == request.auth.token.email
               )
             ) &&
             request.resource.data.get('status', '') == 'completed' &&
             request.resource.data.get('completedBy', '') == request.auth.uid &&
             request.resource.data.diff(resource.data).affectedKeys().hasOnly([
               'status',
               'completedAt',
               'completedBy',
               'completionBookingId'
             ]);
    }

    function wasCompletedByCurrentDriver(instanceId) {
      return request.auth != null &&
             instanceId is string &&
             instanceId != '' &&
             exists(/databases/$(database)/documents/tour_instances/$(instanceId)) &&
             getAfter(
               /databases/$(database)/documents/tour_instances/$(instanceId)
             ).data.get('status', '') == 'completed' &&
             getAfter(
               /databases/$(database)/documents/tour_instances/$(instanceId)
             ).data.get('completedBy', '') == request.auth.uid;
    }

    function recordsNewCompletedTour(instanceId) {
      let beforeInstance = get(
        /databases/$(database)/documents/tour_instances/$(instanceId)
      ).data;
      let afterInstance = getAfter(
        /databases/$(database)/documents/tour_instances/$(instanceId)
      ).data;
      return request.auth != null &&
             instanceId is string &&
             instanceId != '' &&
             beforeInstance.get('status', '') != 'completed' &&
             afterInstance.get('status', '') == 'completed' &&
             afterInstance.get('completedBy', '') == request.auth.uid;
    }

    // TOURS COLLECTION - PUBLIC READ (Allow everyone to browse tours)
    match /tours/{tourId} {
      allow read; // Public access - everyone can read tours
      allow create: if request.auth != null && (
        request.auth.uid == request.resource.data.guideId ||
        isAdmin() ||
        (request.resource.data.keys().hasAll(['sourceIdleTourId']) && request.resource.data.sourceIdleTourId != '')
      );
      allow update: if request.auth != null;
      allow delete: if request.auth != null && isAdmin();

      // Bookings subcollection
      match /bookings/{subBookingId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null && 
                      request.resource.data.userId == request.auth.uid;
        allow update, delete: if request.auth != null;
      }
    }

    // Active booked occurrences are public, while authenticated users create/update them.
    match /tour_instances/{instanceId} {
      allow read;
      allow create: if request.auth != null;
      allow update: if isAdmin() ||
                    (
                      request.auth != null &&
                      request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                        'totalSeats',
                        'available_seats',
                        'remainingSeats',
                        'bookedSeats',
                        'bookedUserIds',
                        'firstBookedUserId'
                      ])
                    ) ||
                    isCompletingAssignedTour(instanceId);
      allow delete: if isAdmin();
    }

    // Public marketing statistics. The completion count can only move by one
    // in the same atomic operation that completes a real tour instance.
    match /app_stats/{statsId} {
      allow read: if statsId == 'global';
      allow create: if statsId == 'global' &&
                    request.resource.data.keys().hasAll([
                      'completedTourCount',
                      'lastCompletedInstanceId',
                      'updatedAt'
                    ]) &&
                    request.resource.data.keys().hasOnly([
                      'completedTourCount',
                      'lastCompletedInstanceId',
                      'updatedAt'
                    ]) &&
                    request.resource.data.completedTourCount == 128 &&
                    request.resource.data.updatedAt == request.time &&
                    recordsNewCompletedTour(
                      request.resource.data.lastCompletedInstanceId
                    );
      allow update: if statsId == 'global' &&
                    request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                      'completedTourCount',
                      'lastCompletedInstanceId',
                      'updatedAt'
                    ]) &&
                    resource.data.completedTourCount is int &&
                    request.resource.data.completedTourCount ==
                      resource.data.completedTourCount + 1 &&
                    request.resource.data.updatedAt == request.time &&
                    recordsNewCompletedTour(
                      request.resource.data.lastCompletedInstanceId
                    );
      allow delete: if false;
    }

    // Users collection - each user has a profile
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth.uid == userId || isAdmin();
    }

    // ROOT-LEVEL MESSAGES COLLECTION
    match /messages/{messageId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && 
                    request.resource.data.senderId == request.auth.uid &&
                    request.resource.data.tourId is string &&
                    request.resource.data.instanceId is string &&
                    exists(
                      /databases/$(database)/documents/tour_instances/$(request.resource.data.instanceId)
                    ) &&
                    get(
                      /databases/$(database)/documents/tour_instances/$(request.resource.data.instanceId)
                    ).data.get('status', '') != 'completed' &&
                    get(
                      /databases/$(database)/documents/tour_instances/$(request.resource.data.instanceId)
                    ).data.get('status', '') != 'cancelled' &&
                    request.resource.data.tourDate is string &&
                    request.resource.data.text is string &&
                    request.resource.data.senderName is string &&
                    request.resource.data.timestamp is timestamp;
      allow delete: if request.auth != null && 
                    (
                      resource.data.senderId == request.auth.uid ||
                      isAdmin() ||
                      wasCompletedByCurrentDriver(
                        resource.data.get(
                          'instanceId',
                          resource.data.get('tourId', '')
                        )
                      )
                    );
      allow update: if false;
    }

    // ROOT-LEVEL BOOKINGS COLLECTION
    match /bookings/{bookingId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && 
                    request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null &&
                    (
                      resource.data.userId == request.auth.uid ||
                      isAdmin() ||
                      (
                        (
                          resource.data.get('driverId', '') == request.auth.uid ||
                          (
                            request.auth.token.email != null &&
                            resource.data.get('driverEmail', '') == request.auth.token.email
                          )
                        ) &&
                        request.resource.data.status == 'completed' &&
                        request.resource.data.completedBy == request.auth.uid &&
                        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                          'status',
                          'completedAt',
                          'completedBy',
                          'updatedAt'
                        ])
                      )
                    ) &&
                    request.resource.data.userId == resource.data.userId;
      allow delete: if request.auth != null &&
                    (resource.data.userId == request.auth.uid || isAdmin());
    }

    // Joined tours (user booking records)
    match /joinedTours/{joinedTourId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && 
                           request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null;
    }

    // Driver live-location sharing
    match /driver_locations/{tourId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && 
                            (request.resource.data.driverId == request.auth.uid || isAdmin());
      allow delete: if request.auth != null && 
                    (resource.data.driverId == request.auth.uid || isAdmin());
    }

    // Admin users collection (reference only)
    match /admin_users/{document=**} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Drivers collection - for admin panel driver management
    match /drivers/{driverId} {
      allow read: if request.auth != null;
      allow create, delete: if request.auth != null && isAdmin();
      allow update: if request.auth != null && (
        isAdmin() ||
        (
          resource.data.status == 'pending' &&
          resource.data.email == request.auth.token.email &&
          request.resource.data.email == resource.data.email &&
          request.resource.data.status == 'active' &&
          request.resource.data.userId == request.auth.uid &&
          request.resource.data.uid == request.auth.uid
        )
      );
    }

    // Admin bypass - allow admins to read/write everything
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}

